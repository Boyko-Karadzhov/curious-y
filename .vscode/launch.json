{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Supabase learning function",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 8083,
      "localRoot": "${workspaceFolder}/supabase/functions",
      "remoteRoot": "/var/tmp/sb-compile-edge-runtime/functions",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "file:///var/tmp/sb-compile-edge-runtime/functions/*": "${workspaceFolder}/supabase/functions/*"
      },
      "enableContentValidation": false,
      "restart": true,
      "timeout": 30000
    }
  ]
}
